generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  passwordHash        String
  profilePicture      String?
  bio                 String?
  createdAt           DateTime @default(now())

  organizedActivities Activity[]            @relation("ActivityOrganizer")
  sentInvitations     Invitation[]          @relation("InvitationSender")
  receivedInvitations Invitation[]          @relation("InvitationReceiver")
  participations      ActivityParticipant[]
  requestedFriendships Friendship[]         @relation("FriendshipRequester")
  receivedFriendships Friendship[]          @relation("FriendshipAddressee")
  lowFriendshipPairs  Friendship[]          @relation("FriendshipLowUser")
  highFriendshipPairs Friendship[]          @relation("FriendshipHighUser")
  directConversationsA Conversation[]        @relation("ConversationParticipantA")
  directConversationsB Conversation[]        @relation("ConversationParticipantB")
  sentMessages        Message[]             @relation("MessageSender")
}

// ─────────────────────────────────────────────
// ACTIVITY TYPE
// ─────────────────────────────────────────────

model ActivityType {
  id   String @id @default(uuid())
  name String @unique

  activities Activity[]
}

// ─────────────────────────────────────────────
// LOCATION
// ─────────────────────────────────────────────

model Location {
  id          String       @id @default(uuid())
  name        String
  description String?
  address     String
  latitude    Decimal      @db.Decimal(10, 7)
  longitude   Decimal      @db.Decimal(10, 7)
  type        LocationType

  facilityDetails FacilityDetails?
  activities      Activity[]
}

// ─────────────────────────────────────────────
// FACILITY DETAILS
// ─────────────────────────────────────────────

model FacilityDetails {
  id          String  @id @default(uuid())
  locationId  String  @unique
  bookingUrl  String?
  rates       String?
  amenities   String?
  contactInfo String?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// ACTIVITY
// ─────────────────────────────────────────────

model Activity {
  id              String         @id @default(uuid())
  organizerId     String
  activityTypeId  String
  locationId      String
  title           String
  description     String?
  date            DateTime
  startTime       DateTime
  endTime         DateTime?
  maxParticipants Int?
  status          ActivityStatus
  createdAt       DateTime       @default(now())

  organizer    User                @relation("ActivityOrganizer", fields: [organizerId], references: [id])
  activityType ActivityType        @relation(fields: [activityTypeId], references: [id])
  location     Location            @relation(fields: [locationId], references: [id])
  bookingProof BookingProof?
  participants ActivityParticipant[]
  invitations  Invitation[]

  @@index([organizerId])
  @@index([activityTypeId])
  @@index([locationId])
  @@index([date])
}

// ─────────────────────────────────────────────
// BOOKING PROOF
// ─────────────────────────────────────────────

model BookingProof {
  id          String             @id @default(uuid())
  activityId  String             @unique
  fileUrl     String
  status      VerificationStatus
  submittedAt DateTime           @default(now())
  verifiedAt  DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// ACTIVITY PARTICIPANT
// ─────────────────────────────────────────────

model ActivityParticipant {
  id         String            @id @default(uuid())
  activityId String
  userId     String
  status     ParticipantStatus @default(PENDING)
  joinedAt   DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// INVITATION
// ─────────────────────────────────────────────

model Invitation {
  id         String           @id @default(uuid())
  activityId String
  senderId   String
  receiverId String
  status     InvitationStatus
  createdAt  DateTime         @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sender   User     @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([activityId, receiverId])
  @@index([receiverId])
}

// ─────────────────────────────────────────────
// FRIENDSHIP
// ─────────────────────────────────────────────

model Friendship {
  id           String           @id @default(uuid())
  requesterId  String
  addresseeId  String
  lowUserId    String
  highUserId   String
  status       FriendshipStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  lowUser   User @relation("FriendshipLowUser", fields: [lowUserId], references: [id], onDelete: Cascade)
  highUser  User @relation("FriendshipHighUser", fields: [highUserId], references: [id], onDelete: Cascade)

  @@unique([lowUserId, highUserId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// ─────────────────────────────────────────────
// DIRECT MESSAGING
// ─────────────────────────────────────────────

model Conversation {
  id              String   @id @default(uuid())
  participantAId  String
  participantBId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participantA User      @relation("ConversationParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User      @relation("ConversationParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId, updatedAt])
  @@index([participantBId, updatedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String   @db.VarChar(500)
  createdAt      DateTime @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, senderId, readAt])
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum LocationType {
  FACILITY
  OUTDOOR
}

enum ActivityStatus {
  DRAFT
  PENDING_VERIFICATION
  CONFIRMED
  REJECTED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParticipantStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}